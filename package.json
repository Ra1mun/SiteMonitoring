{
  "name": "site-monitoring",
  "version": "1.0.0",
  "description": "Сервис мониторинга доступности веб-сайтов",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "vitest run",
    "test:smoke": "npm run build && node scripts/smoke.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.cjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.cjs\""
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "p-limit": "^3.1.0",
    "prisma": "^5.22.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.15",
    "@types/swagger-ui-express": "^4.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
